# =============================================================
# ENVIRONMENT VARIABLES — fill in every value below, then this
# app is ready to run. Next.js reads THIS exact filename
# (.env.local) automatically — don't rename it.
# =============================================================

# ---------- DATABASE (Postgres — Supabase or Neon, free tier) ----------
# DATABASE_URL = pooled connection string (used by the app at runtime)
# DIRECT_URL   = direct/non-pooled connection string (used only for migrations)
# Get both from your Supabase/Neon project's connection settings.
DATABASE_URL="postgresql://user:password@pooler-host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@direct-host:5432/postgres"

# ---------- BOLNA (voice agent — answers calls, talks to the caller) ----------
# Get this from Bolna's dashboard -> Settings -> API Keys.
BOLNA_API_KEY=your_bolna_api_key

# The agent Bolna should use for OUTBOUND speed-to-lead calls (Bolna
# dashboard -> your agent -> copy its Agent ID from the URL/settings).
# Required for outbound calling; not needed if you only ever receive
# inbound calls and rely on the webhook below.
BOLNA_AGENT_ID=your_bolna_agent_id

# Optional: the Bolna/Twilio/Exotel number to call FROM. If omitted, Bolna
# uses the agent's default configured number.
BOLNA_FROM_PHONE_NUMBER=

# Speed-to-lead: automatically place an outbound Bolna call the moment a
# new lead is created (unless it came in FROM a phone call already). Set to
# "false" to disable and only call leads manually via the dashboard's
# "Call Now" button.
AUTO_CALL_NEW_LEADS=true

# Optional shared secret — if set, add ?secret=<same value> to the webhook
# URL you give Bolna, and this app will reject requests without it.
BOLNA_WEBHOOK_SECRET=

# ---------- CAL.COM (booking) ----------
# Get this from Cal.com -> Settings -> Developer -> Webhooks, when you
# create the webhook pointing at this app. Used to verify the request
# really came from Cal.com (HMAC signature check).
CALCOM_WEBHOOK_SECRET=whatever_you_set_in_calcom_dashboard

# ---------- AUTH (protects the dashboard + all internal APIs) ----------
# Single-admin login. Generate the hash with:
#   node scripts/hash-password.mjs "your-chosen-password"
# then paste its output below (never put the plain password here).
AUTH_USERNAME=admin
AUTH_PASSWORD_HASH=
# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=

# ---------- GROQ (optional) ----------
# Only used by the dashboard's local "Voice Test" page, for quickly testing
# how your system prompt reads before pasting it into Bolna. Not used
# during real phone calls — Bolna runs its own LLM for that.
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_key
